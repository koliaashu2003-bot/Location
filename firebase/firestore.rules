rules_version = '2';

// Family Location Tracker security rules.
//
// Only authenticated users can read or write. This keeps the data private to
// people you have created accounts for in Firebase Auth.
//
// The dashboard signs in with Email/Password; the phone agent signs in
// Anonymously on startup. Both satisfy `request.auth != null`, so enable both
// providers in Firebase Console → Authentication → Sign-in method.
// For a purely private family setup on the free tier, this is a sensible
// baseline — tighten further per-device if you wish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Location data: locations/{deviceId} and its history subcollection.
    match /locations/{deviceId} {
      allow read, write: if request.auth != null;

      match /history/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // Screen time data: screentime/{deviceId} and daily subcollection.
    match /screentime/{deviceId} {
      allow read, write: if request.auth != null;

      match /daily/{date} {
        allow read, write: if request.auth != null;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
