# Copy this file to `.env` and fill in your Firebase Web app config.
# Firebase Console → Project settings → Your apps → Web app → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=family-tracker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=family-tracker
VITE_FIREBASE_STORAGE_BUCKET=family-tracker.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
